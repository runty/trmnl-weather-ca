<div class="layout layout--col gap--distribute">
  <!-- Current Conditions + 7-Day -->
  <div class="flex flex--between flex--center-y w--full pb--1 border-b-2">
    <div class="flex flex--center-y gap--small">
      {% if cc.iconCode.value >= 10 %}
        <img src="https://weather.gc.ca/weathericons/{{ cc.iconCode.value }}.gif" width="48" height="48" class="image--contain" />
      {% else %}
        <span class="value value--xlarge">{% if cc.iconCode.value == 0 or cc.iconCode.value == 1 %}☀{% elsif cc.iconCode.value <= 5 %}⛅{% elsif cc.iconCode.value <= 7 %}🌧{% elsif cc.iconCode.value == 8 %}❄{% else %}⛈{% endif %}</span>
      {% endif %}
      <div>
        <span class="value value--xxlarge bold">{{ cc.temperature.value.en | round }}°</span>
      </div>
      <div>
        <span class="label bold">{{ cc.condition.en }}</span>
        <div class="description">Wind {{ cc.wind.direction.value.en }} {{ cc.wind.speed.value.en }} km/h · Humidity {{ cc.relativeHumidity.value.en }}%</div>
      </div>
    </div>

    <!-- 6-Day Forecast -->
    <div class="flex gap--medium">
      {% assign day_count = 0 %}
      {% for fc in daily %}
        {% assign period = fc.period.textForecastName.en %}
        {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
        {% if day_count >= 6 %}{% break %}{% endif %}
        <div class="text--center">
          <div class="description bold">{{ period | truncate: 3, "" }}</div>
          {% if fc.abbreviatedForecast.icon.value >= 10 %}
            <img src="https://weather.gc.ca/weathericons/{{ fc.abbreviatedForecast.icon.value }}.gif" width="22" height="22" class="image--contain" />
          {% else %}
            <span class="text-sm">{% if fc.abbreviatedForecast.icon.value == 0 or fc.abbreviatedForecast.icon.value == 1 %}☀{% elsif fc.abbreviatedForecast.icon.value <= 5 %}⛅{% elsif fc.abbreviatedForecast.icon.value <= 7 %}🌧{% elsif fc.abbreviatedForecast.icon.value == 8 %}❄{% else %}⛈{% endif %}</span>
          {% endif %}
          {% for t in fc.temperatures.temperature %}
            {% if t.class.en == "high" %}
              <div class="label label--small bold">{{ t.value.en }}°</div>
            {% endif %}
          {% endfor %}
          {% assign next_idx = forloop.index %}
          {% assign night_fc = daily[next_idx] %}
          {% if night_fc %}
            {% for t in night_fc.temperatures.temperature %}
              {% if t.class.en == "low" %}
                <div class="description">{{ t.value.en }}°</div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        {% assign day_count = day_count | plus: 1 %}
      {% endfor %}
    </div>
  </div>

  <!-- 24-Hour Forecast (3 columns x 8 rows) -->
  <div class="hourly-grid grow">
    {% for h in hourly limit: 24 %}
      <div class="hour-row">
        <span class="hour-time description text-sm nowrap">{{ h.timestamp | date: "%-I%P" }}</span>
        {% if h.iconCode.value >= 10 %}
          <img src="https://weather.gc.ca/weathericons/{{ h.iconCode.value }}.gif" width="18" height="18" class="image--contain" />
        {% else %}
          <span class="text-sm">{% if h.iconCode.value == 0 or h.iconCode.value == 1 %}☀{% elsif h.iconCode.value <= 5 %}⛅{% elsif h.iconCode.value <= 7 %}🌧{% elsif h.iconCode.value == 8 %}❄{% else %}⛈{% endif %}</span>
        {% endif %}
        <span class="hour-temp label label--small bold">{{ h.temperature.value.en }}°</span>
        <div class="hour-bar-wrap">
          {% if h.lop.value.en > 10 %}
            <div class="hour-bar" style="width: {{ h.lop.value.en }}%;"></div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  {% if cc.iconCode.value >= 10 %}
    <img class="image" src="https://weather.gc.ca/weathericons/{{ cc.iconCode.value }}.gif" />
  {% endif %}
  <span class="title">{{ city }}</span>
  <span class="instance">{{ region }}</span>
</div>

<div class="layout layout--col gap--distribute">
  <!-- Current Conditions + 6-Day -->
  <div class="flex flex--between flex--center-y w--full pb--1 border-b-2">
    <div class="flex flex--center-y gap--small no-shrink">
      {% assign ec = cc.iconCode.value | plus: 0 %}
      {% case ec %}{% when 0, 1 %}{% assign wi = "wi-day-sunny" %}{% when 2 %}{% assign wi = "wi-day-cloudy" %}{% when 3, 5 %}{% assign wi = "wi-day-cloudy-high" %}{% when 4, 6, 10 %}{% assign wi = "wi-cloudy" %}{% when 9, 11, 12 %}{% assign wi = "wi-day-rain" %}{% when 13, 14, 15 %}{% assign wi = "wi-day-rain-mix" %}{% when 16, 17 %}{% assign wi = "wi-day-snow" %}{% when 18, 24, 25, 26 %}{% assign wi = "wi-snow-wind" %}{% when 19 %}{% assign wi = "wi-day-thunderstorm" %}{% when 20, 21 %}{% assign wi = "wi-day-haze" %}{% when 22, 23 %}{% assign wi = "wi-day-fog" %}{% when 27, 28 %}{% assign wi = "wi-day-sprinkle" %}{% when 30, 31 %}{% assign wi = "wi-night-clear" %}{% when 32 %}{% assign wi = "wi-night-alt-partly-cloudy" %}{% when 33, 34, 35 %}{% assign wi = "wi-night-alt-cloudy" %}{% when 36, 37, 38 %}{% assign wi = "wi-night-alt-rain" %}{% when 39 %}{% assign wi = "wi-night-alt-thunderstorm" %}{% when 40, 41 %}{% assign wi = "wi-night-alt-snow" %}{% when 42, 43 %}{% assign wi = "wi-tornado" %}{% when 44 %}{% assign wi = "wi-strong-wind" %}{% else %}{% assign wi = "wi-cloud" %}{% endcase %}
      {% if ec == 9 or ec == 11 or ec == 12 or ec == 13 or ec == 14 or ec == 15 or ec == 16 or ec == 17 or ec == 18 or ec == 19 or ec == 24 or ec == 25 or ec == 26 or ec == 27 or ec == 28 or ec == 36 or ec == 37 or ec == 38 or ec == 39 or ec == 40 or ec == 41 or ec == 42 or ec == 43 %}{% assign wc = "wi-precip" %}{% else %}{% assign wc = "" %}{% endif %}
      <i class="wi {{ wi }} {{ wc }} wi-xxl"></i>
      <span class="value value--xxlarge bold">{{ cc.temperature.value.en | round }}°</span>
      <div>
        <span class="label label--small bold">{{ cc.condition.en }}</span>
        <div class="description text-sm">{{ cc.wind.direction.value.en }} {{ cc.wind.speed.value.en }}km/h · {{ cc.relativeHumidity.value.en }}%</div>
      </div>
    </div>

    <!-- 6-Day Forecast -->
    <table class="daily-tbl">
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td><span class="label label--small bold">{{ period | truncate: 3, "" }}</span></td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td>
            {% assign ec = fc.abbreviatedForecast.icon.value | plus: 0 %}
            {% case ec %}{% when 0, 1 %}{% assign wi = "wi-day-sunny" %}{% when 2 %}{% assign wi = "wi-day-cloudy" %}{% when 3, 5 %}{% assign wi = "wi-day-cloudy-high" %}{% when 4, 6, 10 %}{% assign wi = "wi-cloudy" %}{% when 9, 11, 12 %}{% assign wi = "wi-day-rain" %}{% when 13, 14, 15 %}{% assign wi = "wi-day-rain-mix" %}{% when 16, 17 %}{% assign wi = "wi-day-snow" %}{% when 18, 24, 25, 26 %}{% assign wi = "wi-snow-wind" %}{% when 19 %}{% assign wi = "wi-day-thunderstorm" %}{% when 20, 21 %}{% assign wi = "wi-day-haze" %}{% when 22, 23 %}{% assign wi = "wi-day-fog" %}{% when 27, 28 %}{% assign wi = "wi-day-sprinkle" %}{% when 30, 31 %}{% assign wi = "wi-night-clear" %}{% when 32 %}{% assign wi = "wi-night-alt-partly-cloudy" %}{% when 33, 34, 35 %}{% assign wi = "wi-night-alt-cloudy" %}{% when 36, 37, 38 %}{% assign wi = "wi-night-alt-rain" %}{% when 39 %}{% assign wi = "wi-night-alt-thunderstorm" %}{% when 40, 41 %}{% assign wi = "wi-night-alt-snow" %}{% when 42, 43 %}{% assign wi = "wi-tornado" %}{% when 44 %}{% assign wi = "wi-strong-wind" %}{% else %}{% assign wi = "wi-cloud" %}{% endcase %}
            {% if ec == 9 or ec == 11 or ec == 12 or ec == 13 or ec == 14 or ec == 15 or ec == 16 or ec == 17 or ec == 18 or ec == 19 or ec == 24 or ec == 25 or ec == 26 or ec == 27 or ec == 28 or ec == 36 or ec == 37 or ec == 38 or ec == 39 or ec == 40 or ec == 41 or ec == 42 or ec == 43 %}{% assign wc = "wi-precip" %}{% else %}{% assign wc = "" %}{% endif %}
            <i class="wi {{ wi }} {{ wc }} wi-md"></i>
          </td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td>
            {% for t in fc.temperatures.temperature %}
              {% if t.class.en == "high" %}<span class="label label--small bold">{{ t.value.en }}°</span>{% endif %}
            {% endfor %}
          </td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td>
            {% assign next_idx = forloop.index %}
            {% assign night_fc = daily[next_idx] %}
            {% if night_fc %}
              {% for t in night_fc.temperatures.temperature %}
                {% if t.class.en == "low" %}<span class="description">{{ t.value.en }}°</span>{% endif %}
              {% endfor %}
            {% endif %}
          </td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
    </table>
  </div>

  <!-- 24-Hour Forecast (table: 8 rows x 3 column groups) -->
  <table class="hourly-tbl grow">
    {% for row in (0..7) %}
      <tr>
        {% for col in (0..2) %}
          {% assign idx = col | times: 8 | plus: row %}
          {% assign h = hourly[idx] %}
          {% if h %}
            {% assign utc_epoch = h.timestamp | date: "%s" | plus: 0 %}
            {% assign local_epoch = utc_epoch | plus: trmnl.user.utc_offset %}
            <td class="nowrap text--right td-time"><span class="label">{{ local_epoch | date: "%-I%P" }}</span></td>
            <td class="text--center td-icon">
              {% assign ec = h.iconCode.value | plus: 0 %}
              {% case ec %}{% when 0, 1 %}{% assign wi = "wi-day-sunny" %}{% when 2 %}{% assign wi = "wi-day-cloudy" %}{% when 3, 5 %}{% assign wi = "wi-day-cloudy-high" %}{% when 4, 6, 10 %}{% assign wi = "wi-cloudy" %}{% when 9, 11, 12 %}{% assign wi = "wi-day-rain" %}{% when 13, 14, 15 %}{% assign wi = "wi-day-rain-mix" %}{% when 16, 17 %}{% assign wi = "wi-day-snow" %}{% when 18, 24, 25, 26 %}{% assign wi = "wi-snow-wind" %}{% when 19 %}{% assign wi = "wi-day-thunderstorm" %}{% when 20, 21 %}{% assign wi = "wi-day-haze" %}{% when 22, 23 %}{% assign wi = "wi-day-fog" %}{% when 27, 28 %}{% assign wi = "wi-day-sprinkle" %}{% when 30, 31 %}{% assign wi = "wi-night-clear" %}{% when 32 %}{% assign wi = "wi-night-alt-partly-cloudy" %}{% when 33, 34, 35 %}{% assign wi = "wi-night-alt-cloudy" %}{% when 36, 37, 38 %}{% assign wi = "wi-night-alt-rain" %}{% when 39 %}{% assign wi = "wi-night-alt-thunderstorm" %}{% when 40, 41 %}{% assign wi = "wi-night-alt-snow" %}{% when 42, 43 %}{% assign wi = "wi-tornado" %}{% when 44 %}{% assign wi = "wi-strong-wind" %}{% else %}{% assign wi = "wi-cloud" %}{% endcase %}
              {% if ec == 9 or ec == 11 or ec == 12 or ec == 13 or ec == 14 or ec == 15 or ec == 16 or ec == 17 or ec == 18 or ec == 19 or ec == 24 or ec == 25 or ec == 26 or ec == 27 or ec == 28 or ec == 36 or ec == 37 or ec == 38 or ec == 39 or ec == 40 or ec == 41 or ec == 42 or ec == 43 %}{% assign wc = "wi-precip" %}{% else %}{% assign wc = "" %}{% endif %}
              <i class="wi {{ wi }} {{ wc }} wi-md"></i>
            </td>
            <td class="nowrap text--right td-temp"><span class="label bold">{{ h.temperature.value.en }}°</span></td>
            {% assign pop = h.lop.value.en | plus: 0 %}
            <td>
              <div class="hour-bar-wrap">
                {% if pop > 10 %}
                  <div class="hour-bar" style="width: {{ pop }}%;"></div>
                {% endif %}
              </div>
            </td>
          {% endif %}
        {% endfor %}
      </tr>
    {% endfor %}
  </table>
</div>

<div class="title_bar">
  <span class="title">{{ city }}</span>
  <span class="instance">{{ region }}</span>
</div>

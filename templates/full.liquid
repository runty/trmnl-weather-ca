<div class="layout layout--col gap--distribute">
  <!-- Current Conditions + 6-Day -->
  <div class="flex flex--between flex--center-y w--full pb--1 border-b-2">
    <div class="flex flex--center-y gap--small no-shrink">
      {% assign ec = cc.iconCode.value | plus: 0 %}
      {% case ec %}{% when 0, 1 %}{% assign ow = "01d" %}{% when 2, 22 %}{% assign ow = "02d" %}{% when 3, 5 %}{% assign ow = "03d" %}{% when 4, 6, 10, 20, 21 %}{% assign ow = "04d" %}{% when 9, 11, 12, 13, 14, 27, 28 %}{% assign ow = "10d" %}{% when 15 %}{% assign ow = "09d" %}{% when 16, 17, 18, 24, 25, 26 %}{% assign ow = "13d" %}{% when 19, 39 %}{% assign ow = "11d" %}{% when 23, 44 %}{% assign ow = "50d" %}{% when 30, 31 %}{% assign ow = "01n" %}{% when 32, 33, 34, 35 %}{% assign ow = "02n" %}{% when 36, 37, 38 %}{% assign ow = "10n" %}{% when 40, 41 %}{% assign ow = "13n" %}{% when 42, 43 %}{% assign ow = "11n" %}{% else %}{% assign ow = "03d" %}{% endcase %}
      <img src="https://openweathermap.org/img/wn/{{ ow }}@2x.png" width="48" height="48" class="image--contain" />
      <span class="value value--xxlarge bold">{{ cc.temperature.value.en | round }}°</span>
      <div>
        <span class="label label--small bold">{{ cc.condition.en }}</span>
        <div class="description text-sm">{{ cc.wind.direction.value.en }} {{ cc.wind.speed.value.en }}km/h · {{ cc.relativeHumidity.value.en }}%</div>
      </div>
    </div>

    <!-- 6-Day Forecast -->
    <table class="daily-tbl">
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td><span class="label label--small bold">{{ period | truncate: 3, "" }}</span></td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td>
            {% assign ec = fc.abbreviatedForecast.icon.value | plus: 0 %}
            {% case ec %}{% when 0, 1 %}{% assign ow = "01d" %}{% when 2, 22 %}{% assign ow = "02d" %}{% when 3, 5 %}{% assign ow = "03d" %}{% when 4, 6, 10, 20, 21 %}{% assign ow = "04d" %}{% when 9, 11, 12, 13, 14, 27, 28 %}{% assign ow = "10d" %}{% when 15 %}{% assign ow = "09d" %}{% when 16, 17, 18, 24, 25, 26 %}{% assign ow = "13d" %}{% when 19, 39 %}{% assign ow = "11d" %}{% when 23, 44 %}{% assign ow = "50d" %}{% when 30, 31 %}{% assign ow = "01n" %}{% when 32, 33, 34, 35 %}{% assign ow = "02n" %}{% when 36, 37, 38 %}{% assign ow = "10n" %}{% when 40, 41 %}{% assign ow = "13n" %}{% when 42, 43 %}{% assign ow = "11n" %}{% else %}{% assign ow = "03d" %}{% endcase %}
            <img src="https://openweathermap.org/img/wn/{{ ow }}@2x.png" width="28" height="28" class="image--contain" />
          </td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td>
            {% for t in fc.temperatures.temperature %}
              {% if t.class.en == "high" %}<span class="label label--small bold">{{ t.value.en }}°</span>{% endif %}
            {% endfor %}
          </td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td>
            {% assign next_idx = forloop.index %}
            {% assign night_fc = daily[next_idx] %}
            {% if night_fc %}
              {% for t in night_fc.temperatures.temperature %}
                {% if t.class.en == "low" %}<span class="description">{{ t.value.en }}°</span>{% endif %}
              {% endfor %}
            {% endif %}
          </td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
    </table>
  </div>

  <!-- 24-Hour Forecast (table: 8 rows x 3 column groups) -->
  <table class="hourly-tbl grow">
    {% for row in (0..7) %}
      <tr>
        {% for col in (0..2) %}
          {% assign idx = col | times: 8 | plus: row %}
          {% assign h = hourly[idx] %}
          {% if h %}
            {% assign utc_epoch = h.timestamp | date: "%s" | plus: 0 %}
            {% assign local_epoch = utc_epoch | plus: trmnl.user.utc_offset %}
            <td class="nowrap text--right" style="width: 40px;"><span class="label">{{ local_epoch | date: "%-I%P" }}</span></td>
            <td style="width: 30px;">
              {% assign ec = h.iconCode.value | plus: 0 %}
              {% case ec %}{% when 0, 1 %}{% assign ow = "01d" %}{% when 2, 22 %}{% assign ow = "02d" %}{% when 3, 5 %}{% assign ow = "03d" %}{% when 4, 6, 10, 20, 21 %}{% assign ow = "04d" %}{% when 9, 11, 12, 13, 14, 27, 28 %}{% assign ow = "10d" %}{% when 15 %}{% assign ow = "09d" %}{% when 16, 17, 18, 24, 25, 26 %}{% assign ow = "13d" %}{% when 19, 39 %}{% assign ow = "11d" %}{% when 23, 44 %}{% assign ow = "50d" %}{% when 30, 31 %}{% assign ow = "01n" %}{% when 32, 33, 34, 35 %}{% assign ow = "02n" %}{% when 36, 37, 38 %}{% assign ow = "10n" %}{% when 40, 41 %}{% assign ow = "13n" %}{% when 42, 43 %}{% assign ow = "11n" %}{% else %}{% assign ow = "03d" %}{% endcase %}
              <img src="https://openweathermap.org/img/wn/{{ ow }}@2x.png" width="30" height="30" class="image--contain" />
            </td>
            <td class="nowrap text--right" style="width: 30px;"><span class="label bold">{{ h.temperature.value.en }}°</span></td>
            {% assign pop = h.lop.value.en | plus: 0 %}
            <td>
              <div class="hour-bar-wrap">
                {% if pop > 10 %}
                  <div class="hour-bar" style="width: {{ pop }}%;"></div>
                {% endif %}
              </div>
            </td>
          {% endif %}
        {% endfor %}
      </tr>
    {% endfor %}
  </table>
</div>

<div class="title_bar">
  {% assign ec = cc.iconCode.value | plus: 0 %}
  {% case ec %}{% when 0, 1 %}{% assign ow = "01d" %}{% when 2, 22 %}{% assign ow = "02d" %}{% when 3, 5 %}{% assign ow = "03d" %}{% when 4, 6, 10, 20, 21 %}{% assign ow = "04d" %}{% when 9, 11, 12, 13, 14, 27, 28 %}{% assign ow = "10d" %}{% when 15 %}{% assign ow = "09d" %}{% when 16, 17, 18, 24, 25, 26 %}{% assign ow = "13d" %}{% when 19, 39 %}{% assign ow = "11d" %}{% when 23, 44 %}{% assign ow = "50d" %}{% when 30, 31 %}{% assign ow = "01n" %}{% when 32, 33, 34, 35 %}{% assign ow = "02n" %}{% when 36, 37, 38 %}{% assign ow = "10n" %}{% when 40, 41 %}{% assign ow = "13n" %}{% when 42, 43 %}{% assign ow = "11n" %}{% else %}{% assign ow = "03d" %}{% endcase %}
  <img class="image" src="https://openweathermap.org/img/wn/{{ ow }}@2x.png" />
  <span class="title">{{ city }}</span>
  <span class="instance">{{ region }}</span>
</div>

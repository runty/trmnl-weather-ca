<div class="layout layout--col gap--distribute">
  <!-- Current Conditions + 7-Day -->
  <div class="flex flex--between flex--center-y w--full pb--1 border-b-2">
    <div class="flex flex--center-y gap--small no-shrink">
      {% if cc.iconCode.value >= 10 %}
        <img src="https://weather.gc.ca/weathericons/{{ cc.iconCode.value }}.gif" width="40" height="40" class="image--contain" />
      {% else %}
        <span class="value value--large">{% if cc.iconCode.value == 0 or cc.iconCode.value == 1 %}☀{% elsif cc.iconCode.value <= 5 %}⛅{% elsif cc.iconCode.value <= 7 %}🌧{% elsif cc.iconCode.value == 8 %}❄{% else %}⛈{% endif %}</span>
      {% endif %}
      <span class="value value--xxlarge bold">{{ cc.temperature.value.en | round }}°</span>
      <div>
        <span class="label label--small bold">{{ cc.condition.en }}</span>
        <div class="description text-sm">{{ cc.wind.direction.value.en }} {{ cc.wind.speed.value.en }}km/h · {{ cc.relativeHumidity.value.en }}%</div>
      </div>
    </div>

    <!-- 6-Day Forecast -->
    <table class="daily-tbl">
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td><span class="label label--small bold">{{ period | truncate: 3, "" }}</span></td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td>
            {% if fc.abbreviatedForecast.icon.value >= 10 %}
              <img src="https://weather.gc.ca/weathericons/{{ fc.abbreviatedForecast.icon.value }}.gif" width="22" height="22" class="image--contain" />
            {% else %}
              <span class="label label--small">{% if fc.abbreviatedForecast.icon.value == 0 or fc.abbreviatedForecast.icon.value == 1 %}☀{% elsif fc.abbreviatedForecast.icon.value <= 5 %}⛅{% elsif fc.abbreviatedForecast.icon.value <= 7 %}🌧{% elsif fc.abbreviatedForecast.icon.value == 8 %}❄{% else %}⛈{% endif %}</span>
            {% endif %}
          </td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td>
            {% for t in fc.temperatures.temperature %}
              {% if t.class.en == "high" %}<span class="label label--small bold">{{ t.value.en }}°</span>{% endif %}
            {% endfor %}
          </td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
      <tr>
        {% assign day_count = 0 %}
        {% for fc in daily %}
          {% assign period = fc.period.textForecastName.en %}
          {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
          {% if day_count >= 6 %}{% break %}{% endif %}
          <td>
            {% assign next_idx = forloop.index %}
            {% assign night_fc = daily[next_idx] %}
            {% if night_fc %}
              {% for t in night_fc.temperatures.temperature %}
                {% if t.class.en == "low" %}<span class="description">{{ t.value.en }}°</span>{% endif %}
              {% endfor %}
            {% endif %}
          </td>
          {% assign day_count = day_count | plus: 1 %}
        {% endfor %}
      </tr>
    </table>
  </div>

  <!-- 24-Hour Forecast (table: 8 rows x 3 column groups) -->
  <table class="hourly-tbl grow">
    {% for row in (0..7) %}
      <tr>
        {% for col in (0..2) %}
          {% assign idx = col | times: 8 | plus: row %}
          {% assign h = hourly[idx] %}
          {% if h %}
            {% assign utc_epoch = h.timestamp | date: "%s" | plus: 0 %}
            {% assign local_epoch = utc_epoch | plus: trmnl.user.utc_offset %}
            <td class="nowrap text--right" style="width: 40px;"><span class="label">{{ local_epoch | date: "%-I%P" }}</span></td>
            <td style="width: 28px;">
              {% if h.iconCode.value >= 10 %}
                <img src="https://weather.gc.ca/weathericons/{{ h.iconCode.value }}.gif" width="28" height="28" class="image--contain" />
              {% else %}
                <span class="label">{% if h.iconCode.value == 0 or h.iconCode.value == 1 %}☀{% elsif h.iconCode.value <= 5 %}⛅{% elsif h.iconCode.value <= 7 %}🌧{% elsif h.iconCode.value == 8 %}❄{% else %}⛈{% endif %}</span>
              {% endif %}
            </td>
            <td class="nowrap text--right" style="width: 30px;"><span class="label bold">{{ h.temperature.value.en }}°</span></td>
            {% assign pop = h.lop.value.en | plus: 0 %}
            <td>
              <div class="hour-bar-wrap">
                {% if pop > 10 %}
                  <div class="hour-bar" style="width: {{ pop }}%;"></div>
                {% endif %}
              </div>
            </td>
            {% if col < 2 %}<td style="width: 8px;"></td>{% endif %}
          {% endif %}
        {% endfor %}
      </tr>
    {% endfor %}
  </table>
</div>

<div class="title_bar">
  {% if cc.iconCode.value >= 10 %}
    <img class="image" src="https://weather.gc.ca/weathericons/{{ cc.iconCode.value }}.gif" />
  {% endif %}
  <span class="title">{{ city }}</span>
  <span class="instance">{{ region }}</span>
</div>

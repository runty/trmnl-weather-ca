<div class="layout layout--col gap--distribute">
  <!-- Current -->
  <div class="flex flex--center-y gap--small w--full">
    <img src="https://weather.gc.ca/weathericons/{{ cc.iconCode.value }}.gif" width="32" height="32" class="image--contain" />
    <span class="value value--large bold">{{ cc.temperature.value.en | round }}°</span>
    <span class="label label--small">{{ cc.condition.en }}</span>
  </div>

  <!-- 3-Day -->
  <div class="w--full pt--1 border-b-2">
    <div class="flex gap--distribute w--full">
      {% assign day_count = 0 %}
      {% for fc in daily %}
        {% assign period = fc.period.textForecastName.en %}
        {% if period contains "night" or period == "Tonight" %}{% continue %}{% endif %}
        {% if day_count >= 3 %}{% break %}{% endif %}
        <div class="text--center">
          <div class="description bold">{{ period | truncate: 3, "" }}</div>
          <img src="https://weather.gc.ca/weathericons/{{ fc.abbreviatedForecast.icon.value }}.gif" width="20" height="20" class="image--contain" />
          {% for t in fc.temperatures.temperature %}
            {% if t.class.en == "high" %}
              <div class="label label--small bold">{{ t.value.en }}°</div>
            {% endif %}
          {% endfor %}
          {% assign next_idx = forloop.index %}
          {% assign night_fc = daily[next_idx] %}
          {% if night_fc %}
            {% for t in night_fc.temperatures.temperature %}
              {% if t.class.en == "low" %}
                <div class="description">{{ t.value.en }}°</div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        {% assign day_count = day_count | plus: 1 %}
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://weather.gc.ca/weathericons/{{ cc.iconCode.value }}.gif" />
  <span class="title">{{ city }}</span>
  <span class="instance">{{ cc.temperature.value.en | round }}°</span>
</div>

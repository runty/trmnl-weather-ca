<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/weather-icons/2.0.12/css/weather-icons.min.css" />
<style>
  *, .title, .value, .label, .description, .instance, .index, span, td, th, div {
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif !important;
  }
  .wi { font-family: 'weathericons' !important; }
  .wi-blue { color: #0000FF !important; }
  .wi-red { color: #FF0000 !important; }
  .border-b-1 { border-bottom: 1px solid #ccc; }
  .border-b-2 { border-bottom: 2px solid black; }
  .border-l-2 { border-left: 2px solid black; }
  .bold { font-weight: bold; }
  .nowrap { white-space: nowrap; }
  .hourly-tbl { width: 100%; border-collapse: separate; border-spacing: 6px 0; }
  .hourly-tbl td { vertical-align: middle; }
  .daily-tbl { border-collapse: collapse; table-layout: fixed; }
  .daily-tbl td { vertical-align: top; width: 50px; }
  .daily-tbl td i { display: block; }
  .hour-bar-wrap { width: 100%; height: 8px; position: relative; background: #ffcc00; }
  .hour-bar { position: absolute; top: 0; left: 0; height: 100%; background: #2266cc; }
  .td-time { width: 40px; }
  .td-time-sm { width: 36px; }
  .td-icon { width: 30px; }
  .td-icon-sm { width: 24px; }
  .td-temp { width: 30px; }
  .td-temp-sm { width: 26px; }
</style>

{% assign cc = properties.currentConditions %}
{% assign city = properties.name.en %}
{% assign region = properties.region.en %}
{% assign hourly = properties.hourlyForecastGroup.hourlyForecasts %}
{% assign daily = properties.forecastGroup.forecasts %}
